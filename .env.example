# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key-here

# Model priority list - try these in order (comma-separated)
# Available models: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro,
# gemini-3-flash, gemini-3.1-pro, gemini-3.1-flash-lite, gemini-3.6-flash,
# gemini-3.5-flash-lite, gemini-3.7-flash, gemini-3.8-flash, gemini-4-argon
GEMINI_MODEL_PRIORITIES=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro

# Set to 1 to test fallback questions/vibe while Gemini is configured.
FORCE_FALLBACKS=1
